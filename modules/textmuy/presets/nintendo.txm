{
  "format": "textmuy-project",
  "version": 1,
  "name": "nintendo",
  "settings": {
    "text": "Fernando",
    "font": {
      "src": "Nintender Regular",
      "size": 114
    },
    "distort": {
      "active": false
    },
    "fill": {
      "color": "#ffffff",
      "texture": {
        "blendmode": "source-over"
      },
      "gradient": {
        "startColor": "#000000",
        "endColor": "#ffffff"
      }
    },
    "lettering": {
      "blendmode": "source-over",
      "flag": {
        "tilt": 12,
        "rise": 10
      },
      "reverseOverlap": {
        "active": true
      },
      "shadow": {
        "fill": {
          "color": "#000000"
        }
      }
    },
    "processing": {
      "active": true,
      "code": "^"
    },
    "depth": {
      "fill": {
        "color": "#ffffff",
        "gradient": {
          "colors": [
            {
              "r": 200,
              "g": 200,
              "b": 200,
              "a": 1,
              "pos": 0
            },
            {
              "r": 255,
              "g": 255,
              "b": 255,
              "a": 1,
              "pos": 1
            }
          ]
        },
        "texture": {
          "blendmode": "source-over"
        }
      }
    },
