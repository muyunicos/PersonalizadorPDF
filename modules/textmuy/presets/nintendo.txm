        "fill": {
          "color": "#000000",
          "gradient": {
            "colors": [
              {
                "r": 0,
                "g": 0,
                "b": 0,
                "pos": 0,
                "a": 1
              },
              {
                "r": 255,
                "g": 255,
                "b": 255,
                "pos": 1,
                "a": 1
              }
            ]
          },
          "texture": {
            "blendmode": "source-over"
          }
        }
      },
      "second": {
        "fill": {
          "color": "#000000",
          "gradient": {
            "colors": [
              {
                "r": 0,
                "g": 0,
                "b": 0,
                "pos": 0,
                "a": 1
              },
              {
                "r": 255,
                "g": 255,
                "b": 255,
                "pos": 1,
                "a": 1
              }
            ]
          },
          "palette": {
            "active": true
          },
          "texture": {
            "blendmode": "source-over"
          }
        }
      },
      "global": {
        "shadow": {
          "color": "#000000"
        },
        "fill": {
          "color": "#ffffff",
          "gradient": {
            "colors": [
              {
                "r": 0,
                "g": 0,
                "b": 0,
                "pos": 0,
                "a": 1
              },
              {
                "r": 255,
                "g": 255,
                "b": 255,
                "pos": 1,
                "a": 1
              }
            ]
          },
          "texture": {
            "blendmode": "source-over"
          }
        }
      }
    },
    "bevel": {
      "inner": {
        "highlight": {
          "blendmode": "source-over",
          "color": "#ffffff"
        },
        "shadow": {
          "blendmode": "source-over",
          "color": "#000000"
        }
      }
    },
    "shadow": {
